{
  "name": "OCR images",
  "pipeline": [
    {
      "operation": "/api/v1/misc/ocr-pdf",
      "parameters": {
        "languages": ["eng"],
        "sidecar": false,
        "deskew": false,
        "clean": false,
        "cleanFinal": false,
        "ocrType": "skip-text",
        "ocrRenderType": "hocr",
        "removeImagesAfter": false
      }
    }
  ],
  "_examples": {
    "outputDir": "{outputFolder}/{folderName}",
    "outputFileName": "{filename}-{pipelineName}-{date}-{time}"
  },
  "outputDir": "httpWebRequest",
  "outputFileName": "{filename}"
}
